# ==========================================
# IoT Environment Monitor - Environment Config
# ==========================================

# MQTT Broker Settings
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=home/room1/env
MQTT_CLIENT_ID=python-env-monitor-subscriber
MQTT_KEEPALIVE=60
MQTT_USERNAME=
MQTT_PASSWORD=

# Alert Thresholds
# Temperature threshold in Celsius (alerts triggered when temp exceeds this)
TEMP_THRESHOLD=30.0
# Humidity threshold in % RH (optional secondary alert)
HUM_THRESHOLD=85.0

# Database Settings
# Path to SQLite database file
DB_PATH=env_data.db

# Service Logging
# Valid options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Firmware Configuration Reference (used when compiling/flashing ESP32)
# WIFI_SSID="Your_WiFi_SSID"
# WIFI_PASSWORD="Your_WiFi_Password"
# FIRMWARE_MQTT_BROKER="192.168.1.100"
